MSSQL_SERVER=localhost
MSSQL_INSTANCE_NAME=MSSQLSERVER01
# Use Windows Authentication when true; otherwise use MSSQL_USER and MSSQL_PASSWORD.
MSSQL_WINDOWS_AUTH=true
# Set MSSQL_PORT instead when connecting to a default instance.
MSSQL_PORT=
